# Backend API URL (must include https:// and the /api prefix)
# Local:
VITE_API_BASE_URL="http://localhost:4001/api"
# Production — API stays on a separate host (Railway/Docker), not under the website path:
# VITE_API_BASE_URL="https://mbointegratedplatform-production.up.railway.app/api"
#
# The SPA itself is served at https://www.mborewards.com/mbointegratedPlatform
# (synced into mbo_frontend via: npm run sync:platform)
